#!/usr/bin/env bash
# FileGuard CLI entry point. Prefers the install's venv.
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Honour a pre-set FILEGUARD_HOME/DATA; otherwise this install is the home.
export FILEGUARD_HOME="${FILEGUARD_HOME:-$ROOT}"
if [ -z "${FILEGUARD_DATA:-}" ]; then
  export FILEGUARD_DATA="$FILEGUARD_HOME/data"
fi
export PYTHONPATH="$FILEGUARD_HOME${PYTHONPATH:+:$PYTHONPATH}"
export PATH="$PATH:/usr/sbin"
if [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="${PYTHON:-python3}"
fi
exec "$PY" -m fileguard.cli "$@"
